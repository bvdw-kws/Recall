{
  "patchId": "mass-entity-query-deterministic-sort",
  "description": "Add deterministic archetype sort in CacheArchetypes for rollback netcode reproducibility (Recall)",
  "plugin": "Recall",
  "versions": [
    {
      "engineVersions": [
        "5.8"
      ],
      "files": [
        {
          "file": "Runtime/MassEntity/Private/MassEntityQuery.cpp",
          "operations": [
            {
              "id": "force-full-rebuild-on-archetype-change",
              "line": 172,
              "remove": [],
              "add": [
                "\t// Force full cache rebuild when archetypes have changed to ensure deterministic ordering",
                "\telse if (bUpdateArchetypes)",
                "\t{",
                "\t\tValidArchetypes.Reset();",
                "\t\tOrderedArchetypeIndices.Reset();",
                "\t\tCachedGroupIDs.Reset();",
                "\t\tLastUpdatedArchetypeDataVersion = 0;",
                "\t\tArchetypeFragmentMapping.Reset();",
                "\t}"
              ]
            },
            {
              "id": "sort-new-valid-archetypes",
              "line": 194,
              "remove": [],
              "add": [
                "\t\t// Sort NewValidArchetypes deterministically for rollback netcode compatibility",
                "\t\tif (NewValidArchetypes.Num() > 1)",
                "\t\t{",
                "\t\t\tNewValidArchetypes.Sort([](const FMassArchetypeHandle& A, const FMassArchetypeHandle& B)",
                "\t\t\t{",
                "\t\t\t\tif (!A.IsValid() || !B.IsValid()) { return A.IsValid() < B.IsValid(); }",
                "\t\t\t\tconst FMassArchetypeData* DataA = &FMassArchetypeHelper::ArchetypeDataFromHandleChecked(A);",
                "\t\t\t\tconst FMassArchetypeData* DataB = &FMassArchetypeHelper::ArchetypeDataFromHandleChecked(B);",
                "\t\t\t\tif (DataA && DataB)",
                "\t\t\t\t{",
                "\t\t\t\t\t// 1. Compare fragment counts",
                "\t\t\t\t\tconst int32 FragmentCountA = DataA->GetFragmentConfigs().Num();",
                "\t\t\t\t\tconst int32 FragmentCountB = DataB->GetFragmentConfigs().Num();",
                "\t\t\t\t\tif (FragmentCountA != FragmentCountB)",
                "\t\t\t\t\t{",
                "\t\t\t\t\t\treturn FragmentCountA < FragmentCountB;",
                "\t\t\t\t\t}",
                "\t\t\t\t\t// 2. Compare bytes per entity",
                "\t\t\t\t\tconst SIZE_T BytesPerEntityA = DataA->GetBytesPerEntity();",
                "\t\t\t\t\tconst SIZE_T BytesPerEntityB = DataB->GetBytesPerEntity();",
                "\t\t\t\t\tif (BytesPerEntityA != BytesPerEntityB)",
                "\t\t\t\t\t{",
                "\t\t\t\t\t\treturn BytesPerEntityA < BytesPerEntityB;",
                "\t\t\t\t\t}",
                "\t\t\t\t\t// 3. Compare the composition by type names. The composition hash uses Mass type indices, which depend on the",
                "\t\t\t\t\t// order the types were registered in the process and so differ between clients.",
                "\t\t\t\t\tconst auto BuildCompositionKey = [](const FMassArchetypeData* Data)",
                "\t\t\t\t\t{",
                "\t\t\t\t\t\tconst FMassArchetypeCompositionDescriptor& Composition = Data->GetCompositionDescriptor();",
                "\t\t\t\t\t\tTArray<FString> Names;",
                "\t\t\t\t\t\tconst auto AppendTypes = [&Names](const TCHAR* Prefix, const auto& BitSet)",
                "\t\t\t\t\t\t{",
                "\t\t\t\t\t\t\tBitSet.ExportTypes([&Names, Prefix](const UScriptStruct* Type)",
                "\t\t\t\t\t\t\t{",
                "\t\t\t\t\t\t\t\tNames.Add(FString(Prefix) + Type->GetPathName());",
                "\t\t\t\t\t\t\t\treturn true;",
                "\t\t\t\t\t\t\t});",
                "\t\t\t\t\t\t};",
                "\t\t\t\t\t\tAppendTypes(TEXT(\"F:\"), Composition.GetFragments());",
                "\t\t\t\t\t\tAppendTypes(TEXT(\"T:\"), Composition.GetTags());",
                "\t\t\t\t\t\tAppendTypes(TEXT(\"C:\"), Composition.GetChunkFragments());",
                "\t\t\t\t\t\tAppendTypes(TEXT(\"S:\"), Composition.GetSharedFragments());",
                "\t\t\t\t\t\tAppendTypes(TEXT(\"K:\"), Composition.GetConstSharedFragments());",
                "\t\t\t\t\t\tNames.Sort();",
                "\t\t\t\t\t\treturn FString::Join(Names, TEXT(\",\"));",
                "\t\t\t\t\t};",
                "\t\t\t\t\tconst int32 CompositionCompare = BuildCompositionKey(DataA).Compare(BuildCompositionKey(DataB));",
                "\t\t\t\t\tif (CompositionCompare != 0)",
                "\t\t\t\t\t{",
                "\t\t\t\t\t\treturn CompositionCompare < 0;",
                "\t\t\t\t\t}",
                "\t\t\t\t}",
                "\t\t\t\t// 4. Final fallback - archetype handle hash",
                "\t\t\t\tensureAlwaysMsgf(false, TEXT(\"%hs TypeHash is null\"), __FUNCTION__);",
                "\t\t\t\treturn GetTypeHash(A) < GetTypeHash(B);",
                "\t\t\t});",
                "\t\t}"
              ]
            }
          ]
        }
      ]
    }
  ]
}
